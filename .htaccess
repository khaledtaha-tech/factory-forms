# ==============================================================================
# Factory Forms - Apache / Hostinger Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

# Central Access Gatekeeper: Route all direct requests to forms/*.html through guard.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^forms/([^/]+\.html)$ guard.php?file=$1 [L,QSA]
</IfModule>

# Protect sensitive and hidden files (.git, .env, .htaccess, config, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security Headers (Supported by Apache / LiteSpeed on Hostinger)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Gzip Compression for Performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Disable execution of scripts in uploads directory
Options -Indexes
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|phar|pl|py|cgi|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
